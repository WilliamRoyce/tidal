[1;33;40m   ### Component field equations[0m


[1;33;40m  #### Metric equation components[0m
E(CT[],CT[]) = 0 : InputForm[(-(Derivative[1][MetricF][CR[]]^2/MetricF[CR[]]) + Derivative[1][MetricF][CR[]]*(4/CR[] - Derivative[1][MetricH][CR[]]/MetricH[CR[]]) + 2*Derivative[2][MetricF][CR[]])/(8*GravitationalCoupling*MetricH[CR[]])]
E(CT[],CR[]) = 0 : InputForm[0]
E(CT[],CTheta[]) = 0 : InputForm[0]
E(CT[],CPhi[]) = 0 : InputForm[0]
E(CR[],CR[]) = 0 : InputForm[(-4*Derivative[1][FuncP][KineticXScalar[]]*Derivative[1][ScalarProfile][CR[]]^2 + (MetricF[CR[]]*(4*MetricF[CR[]] + CR[]*Derivative[1][MetricF][CR[]])*Derivative[1][MetricH][CR[]] + CR[]*MetricH[CR[]]*(Derivative[1][MetricF][CR[]]^2 - 2*MetricF[CR[]]*Derivative[2][MetricF][CR[]]))/(GravitationalCoupling*CR[]*MetricF[CR[]]^2*MetricH[CR[]]))/8]
E(CR[],CTheta[]) = 0 : InputForm[0]
E(CR[],CPhi[]) = 0 : InputForm[0]
E(CTheta[],CTheta[]) = 0 : InputForm[(2 - (2 + (CR[]*Derivative[1][MetricF][CR[]])/MetricF[CR[]])/MetricH[CR[]] + (CR[]*Derivative[1][MetricH][CR[]])/MetricH[CR[]]^2)/(4*GravitationalCoupling)]
E(CTheta[],CPhi[]) = 0 : InputForm[0]
E(CPhi[],CPhi[]) = 0 : InputForm[(Sin[CTheta[]]^2*(-(CR[]*MetricH[CR[]]*Derivative[1][MetricF][CR[]]) + MetricF[CR[]]*(-2*MetricH[CR[]] + 2*MetricH[CR[]]^2 + CR[]*Derivative[1][MetricH][CR[]])))/(4*GravitationalCoupling*MetricF[CR[]]*MetricH[CR[]]^2)]


[1;33;40m  #### Scalar equation components[0m
KG = 0 : InputForm[(CR[]*MetricH[CR[]]^2*Derivative[1][FuncP][KineticXScalar[]]*Derivative[1][MetricF][CR[]]*Derivative[1][ScalarProfile][CR[]] + MetricF[CR[]]*(CR[]*Derivative[1][MetricH][CR[]]*Derivative[1][ScalarProfile][CR[]]^3*Derivative[2][FuncP][KineticXScalar[]] + 2*MetricH[CR[]]^2*Derivative[1][FuncP][KineticXScalar[]]*(2*Derivative[1][ScalarProfile][CR[]] + CR[]*Derivative[2][ScalarProfile][CR[]]) - CR[]*MetricH[CR[]]*Derivative[1][ScalarProfile][CR[]]*(Derivative[1][FuncP][KineticXScalar[]]*Derivative[1][MetricH][CR[]] + 2*Derivative[1][ScalarProfile][CR[]]*Derivative[2][FuncP][KineticXScalar[]]*Derivative[2][ScalarProfile][CR[]])))/(2*CR[]*MetricF[CR[]]*MetricH[CR[]]^3)]


