[1;33;40m  ---> The Riemannian gravity action from Mukohyama-Uzan Eq. (3.6) is S_g = integral d^4x sqrt(g_E) { G4(X_E) R_E + K(X_E) - 2 G4'(X_E) [ (Box_E phi)^2 - (nabla_E_a nabla_E_b phi)(nabla_E^a nabla_E^b phi) ] }.[0m


[1;33;40m  ---> Construct the Lagrangian. Each contraction uses distinct dummy indices.[0m
L_E = InputForm[FuncK[CDE[-a][ClockField[]]*CDE[a][ClockField[]]] + FuncG4[CDE[-a][ClockField[]]*CDE[a][ClockField[]]]*RicciScalarCDE[] - 2*(-(CDE[-c][CDE[-d][ClockField[]]]*CDE[c][CDE[d][ClockField[]]]) + CDE[-c][CDE[c][ClockField[]]]*CDE[-d][CDE[d][ClockField[]]])*Derivative[1][FuncG4][CDE[-a][ClockField[]]*CDE[a][ClockField[]]]]


