# Phase E — Localised wavepacket + dual-Gaussian B-field — canonical geometry
#
# THIS IS THE SINGLE SOURCE OF TRUTH for all Phase E parameter choices.
# Every submit script in this directory `source`s this file. Any change here
# invalidates all prior Phase E runs and triggers a re-baseline.
#
# Frozen on 2026-05-24 (commit will be appended once Stage 0 lands).
# See docs/PHASE_E_TRACKER.md decision log for rationale per parameter.
#
# ─── Physical regime ────────────────────────────────────────────────────────
# High-frequency Gertsenshtein: lambda_GW << L_field, perturbative kappa*B*D << 1.
# k_carrier * sigma_B ≈ 15  → carrier oscillates ~5 times across B-field width.
# kappa * Bpeak * sigma_B * sqrt(2*pi) / 2 ≈ 0.063  → perturbative, far from
# any Boccaletti node at n*pi (verified by v3e_boccaletti_preflight.py).
# ─── Box & grid ─────────────────────────────────────────────────────────────
export L=200                # box length (code units)
export N=512                # grid points (dz = 0.391)
export BC=periodic          # required for modal solver
# ─── Dual-Gaussian B-field ──────────────────────────────────────────────────
export ZC1=50               # first B-field peak (= L/4)
export ZC2=150              # second B-field peak (= 3L/4) — NUMERICAL ONLY (dual-Gaussian periodicity, wavepacket must not reach)
export SIGB=5               # B-field width (13 cells/sigma)
export BPEAK=0.01           # field amplitude (perturbative)
# ─── Wavepacket IC ──────────────────────────────────────────────────────────
export X_C=15               # wavepacket center; ~7*sigma_B from B-field on entry
export SIGMA_W=5            # envelope width (13 cells/sigma)
export K_CARRIER=3          # carrier wavevector (lambda ~= 2.094; k*sigma_B = 15)
export H0=0.01              # IC amplitude (linear regime; h0^2 = 1e-4)
# ─── Time evolution ─────────────────────────────────────────────────────────
export T_END=80             # wavepacket front at z=100 at t_end (well below zc2-3*sigB=135); wavepacket back clears field (zc1+3*sigB=65) at t≈55, giving a 25-unit post-transit window for the A-plateau test
export T_CHECK_1=60         # JUST post-transit (5 units after back clears field) — A should have reached its asymptote here for a clean theory
export T_CHECK_2=80         # WELL post-transit (25 units after back clears) — same A as t_check_1 ⇒ amplification saturated; growth ⇒ catastrophic in vacuum
# ─── Atlas (cubed-sphere) ───────────────────────────────────────────────────
export R_ATLAS=0.4          # coupling-space sphere radius; r=1.0 is canonical unit prior
export N_TILES_PER_FACE=1   # cube atlas tile count per face
# ─── Inference ──────────────────────────────────────────────────────────────
export SNAPSHOTS=2          # mandatory per feedback_snapshots_mandatory.md
# ────────────────────────────────────────────────────────────────────────────
