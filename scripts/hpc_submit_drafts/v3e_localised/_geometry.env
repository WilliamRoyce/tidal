# Phase E — Localised wavepacket + dual-Gaussian B-field — canonical geometry
#
# THIS IS THE SINGLE SOURCE OF TRUTH for all Phase E parameter choices.
# Every submit script in this directory `source`s this file. Any change here
# invalidates all prior Phase E runs and triggers a re-baseline.
#
# Frozen on 2026-05-24 (commit will be appended once Stage 0 lands).
# See docs/PHASE_E_TRACKER.md decision log for rationale per parameter.
#
# ─── Physical regime ────────────────────────────────────────────────────────
# High-frequency Gertsenshtein: lambda_GW << L_field, perturbative kappa*B*D << 1.
# k_carrier * sigma_B ≈ 15  → carrier oscillates ~5 times across B-field width.
# kappa * Bpeak * sigma_B * sqrt(2*pi) / 2 ≈ 0.063  → perturbative, far from
# any Boccaletti node at n*pi (verified by v3e_boccaletti_preflight.py).
# ─── Box & grid ─────────────────────────────────────────────────────────────
export L=100                # box length (code units) — halved from 200 to reduce modal-matrix cost
export N=128                # grid points (dz = 0.781; k_Nyquist = π·N/L = 4.02; k_carrier=2 → 50% Nyquist, well-resolved)
export BC=periodic          # required for modal solver
# ─── Dual-Gaussian B-field ──────────────────────────────────────────────────
export ZC1=25               # first B-field peak (= L/4) — matches Phase E.0 validation
export ZC2=75               # second B-field peak (= 3L/4) — NUMERICAL ONLY (dual-Gaussian periodicity, wavepacket must not reach)
export SIGB=5               # B-field width (6.4 cells/sigma at dz=0.78; same physical scale as L=200 setup)
export BPEAK=0.01           # field amplitude (perturbative — κ·Bpeak·σB·√(2π)/2 ≈ 0.063)
# ─── Wavepacket IC ──────────────────────────────────────────────────────────
export X_C=8                # wavepacket center; ~3.4*sigma_B from B-field on entry
export SIGMA_W=3            # envelope width (3.8 cells/sigma); tail wraps to z≈99, ~24 units from zc2=75
export K_CARRIER=2          # carrier wavevector (lambda ≈ π; 4 cells/wavelength; k*sigB = 10 — still high-frequency regime)
export H0=0.01              # IC amplitude (linear regime; h0^2 = 1e-4)
# ─── Time evolution ─────────────────────────────────────────────────────────
export T_END=40             # wavepacket center at z=48 = 3.6σ_B past zc1+3σ_B=40 boundary; front at z=51, well below zc2-3σ_B=60
export T_CHECK_1=30         # JUST post-transit — front at z=41, just past field boundary
export T_CHECK_2=40         # WELL post-transit — front at z=51, A should be saturated; growth ⇒ catastrophic
# ─── Atlas (cubed-sphere) ───────────────────────────────────────────────────
export R_ATLAS=0.4          # coupling-space sphere radius; r=1.0 is canonical unit prior
export N_TILES_PER_FACE=1   # cube atlas tile count per face
# ─── Inference ──────────────────────────────────────────────────────────────
export SNAPSHOTS=2          # mandatory per feedback_snapshots_mandatory.md
# ────────────────────────────────────────────────────────────────────────────
