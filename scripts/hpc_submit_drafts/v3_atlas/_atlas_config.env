# Phase E Atlas Pivot — uniform-field cubed-sphere atlas campaign.
# SINGLE SOURCE OF TRUTH for atlas parameters. Sourced by run_atlas_slot.sh
# on the INTR compute node. Frozen 2026-05-29; change only with explicit
# re-baselining decision (logged in docs/PHASE_E_ATLAS_TRACKER.md).
#
# Match v3 uniform-field geometry (matches existing v3 corner chains for
# direct posterior comparability — see hpc_results/29189748 etc.).

# ─── Geometry (matches v3 d1_amp.sh pattern) ─────────────────────────────────
export GRID=64
export L=50
export BC=periodic
export B0=0.01
export H0=0.01
export K_CARRIER=2.0          # plane-wave (auto-snapped to grid mode)
export T_END=10
export SNAPSHOTS=2            # mandatory per feedback_snapshots_mandatory.md

# ─── Atlas — single narrow shell, amp only, M=1 single tile per face ─────────
export R_LO=0.35
export R_HI=0.45              # ratio r_hi/r_lo = 1.286, volume bias r^(N-1)
                              # bounded by 1.286^8 ≈ 6 even at ndim=9
                              # (compare to ~10^54 for the smoke tile 29204991's r ∈ [1e-3, 1e3])
export M_TILES=1              # single tile per face

# ─── Per-theory PolyChord budget (LANDSCAPE quality) ─────────────────────────
# NLIVE = 25 * ndim
# NUM_REPEATS = 2 * ndim
# PRECISION_CRITERION = 0.01

# ─── INTR slot capacity (sapphire = 112 cores/node, 1 h walltime) ────────────
# RANKS_PER_CHAIN is set per-theory in run_atlas_slot.sh case statement to
# pack multiple theories into one INTR allocation.
#
# Per the approved plan slot table:
#   S1 (T4 + T1): 6 ranks/chain × 8 faces × 2 theories = 96 cores
#   S2 (T5.0 + T5.1): 4 ranks/chain × (10 + 12) chains = 88 cores
