{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "words": [
    "atleast",
    "axhline",
    "biharmonic",
    "blit",
    "cbar",
    "clim",
    "cmap",
    "contourf",
    "dphi",
    "dpkg",
    "Gaussians",
    "gertsenshtein",
    "hyperbolicity",
    "imshow",
    "KGPDE",
    "kgsim",
    "Lagrangians",
    "Laplacians",
    "libx",
    "linearization",
    "llvmlite",
    "lualatex",
    "Mathematica",
    "mypy",
    "Neumann",
    "numba",
    "pycache",
    "rcfonts",
    "repr",
    "rtol",
    "sharey",
    "sympy",
    "venv",
    "viridis",
    "vmax",
    "vmin",
    "wspace",
    "xelatex",
    "xlim",
    "xtick",
    "xticklabels",
    "xticks",
    "ydata",
    "ylim",
    "ytick",
    "yticklabels",
    "yticks"
  ],
  "ignoreWords": [
    "pytest",
    "pyright",
    "pydata",
    "pylint",
    "pydocstyle",
    "numpy",
    "isort",
    "ndarray",
    "xlabel",
    "ylabel",
    "pyproject",
    "scipy",
    "trange",
    "tqdm"
  ],
  "flagWords": [
    "hte",
    "teh"
  ],
  "allowCompoundWords": true,
  "maxNumberOfProblems": 1000,
  "ignorePaths": [
    "*.snap",
    "node_modules",
    "__snapshots__",
    "package-lock.json",
    "coverage/**",
    "dist/**",
    "dist.*/**",
    "temp/**",
    "CHANGELOG.md",
    "package.json",
    ".cspell.json",
    "cspell.json",
    ".vscode/**",
    ".devcontainer/**",
    ".github/**",
    ".pytest_cache/**",
    ".ruff_cache/**",
    ".venv/**",
    ".vscode/**",
    "build/**",
    "docs/**",
    "*.egg-info/**"
  ],
  "noConfigSearch": true
}
