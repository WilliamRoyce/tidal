\usepackage{cambridgecolours}

\def\beamer@theme@base@blue{
  % 2024 Cambridge brand palette (Johnson Banks refresh).
  % Source: cam.ac.uk/brand-resources/guidelines/colour.
  % Core = light-turquoise anchor; Light = pale tint; Dark = dark-teal accent.
  \definecolor{CambridgeCore}{named}{Cambridge24Blue}
  \definecolor{CambridgeLight}{named}{Cambridge24LightBlue}
  \definecolor{CambridgeDark}{named}{Cambridge24DarkBlue}
}
\def\beamer@theme@base@orange{
  \definecolor{CambridgeCore}{named}{CambridgeCoreOrange}
  \definecolor{CambridgeLight}{named}{CambridgeLightOrange}
  \definecolor{CambridgeDark}{named}{CambridgeDarkOrange}
}
\def\beamer@theme@base@purple{
  \definecolor{CambridgeCore}{named}{CambridgeCorePurple}
  \definecolor{CambridgeLight}{named}{CambridgeLightPurple}
  \definecolor{CambridgeDark}{named}{CambridgeDarkPurple}
}
\def\beamer@theme@base@green{
  \definecolor{CambridgeCore}{named}{CambridgeCoreGreen}
  \definecolor{CambridgeLight}{named}{CambridgeLightGreen}
  \definecolor{CambridgeDark}{named}{CambridgeDarkGreen}
}
\def\beamer@theme@base@teal{
  \definecolor{CambridgeCore}{named}{CambridgeCoreTeal}
  \definecolor{CambridgeLight}{named}{CambridgeLightTeal}
  \definecolor{CambridgeDark}{named}{CambridgeDarkTeal}
}

\beamer@theme@base@blue
\DeclareOptionBeamer{base}{\csname beamer@theme@base@#1\endcsname}
\ProcessOptionsBeamer

\mode<presentation>

% Accessibility constraints from the 2024 Cambridge brand guidelines:
%   - no Cambridge-Blue (turquoise) text on white;
%   - no white text on a Cambridge-Blue fill;
%   - body text in Slate 4, not pure black;
%   - headers / titles on light fills use Cambridge Dark Blue.
\setbeamercolor*{normal text}{fg=Cambridge24Slate4,bg=CambridgeLight!20!white}
\setbeamercolor*{structure}{fg=CambridgeDark}

\setbeamercolor*{palette primary}{fg=CambridgeDark,bg=CambridgeLight}
\setbeamercolor*{palette secondry}{fg=white,bg=CambridgeDark}
\setbeamercolor*{palette tertiary}{fg=white,bg=CambridgeDark!80!black}
\setbeamercolor*{palette quaternary}{fg=CambridgeDark,bg=CambridgeLight!40!white}

% Title-slide layout:
%   - title strip                       : Cambridge Blue (turquoise anchor)
%   - canvas + author/date strips       : Cambridge Light Blue (pale tint)
% All fg=Cambridge Dark Blue for accessibility (no white-on-turquoise).
\setbeamercolor*{title}{fg=Cambridge24DarkBlue,bg=CambridgeCore}
\setbeamercolor*{author}{fg=Cambridge24DarkBlue,bg=CambridgeLight}
\setbeamercolor*{institute}{parent=author}
\setbeamercolor*{date}{fg=Cambridge24DarkBlue,bg=CambridgeLight}
\setbeamercolor*{abstract}{parent=author}

\setbeamercolor*{lower separation line head}{fg=CambridgeDark,bg=CambridgeCore}

\setbeamercolor*{special page canvas}{bg=CambridgeLight}
\setbeamercolor*{special page separator upper}{bg=CambridgeLight!40!white}
\setbeamercolor*{special page separator lower}{bg=CambridgeDark!40!white}
\setbeamercolor*{special page title}{fg=CambridgeDark,bg=CambridgeCore}

\setbeamercolor*{block body}{bg=CambridgeLight!50!normal text.bg,fg=Cambridge24Slate4}
\setbeamercolor*{block title}{bg=CambridgeDark,fg=white}

% Alerted text: Dark Crest (warm orange-red) so the accent contrasts the
% turquoise / teal core and matches the figure-overlay highlight colour.
\setbeamercolor*{alerted text}{fg=Cambridge24DarkCrest}

% Frame title: Cambridge Dark Blue (matches "structure" role) — larger,
% bolder font is applied via beamerinnerthemecambridge.sty.
\setbeamercolor*{frametitle}{fg=Cambridge24DarkBlue}

\mode<all>
