.ruff_cache
__pycache__/
*.egg-info/
third_party/

phd-application-context.md

# examples/data: ignore sim output subdirs but keep theory JSONs
/examples/data/*
!/examples/data/*.json
!/examples/data/README.md

*.png
/outputs/

importtime.log
wolfram_test_output.txt
.coverage

.claude-memory-backup/
