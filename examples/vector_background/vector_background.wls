#!/usr/bin/env wolframscript
(* Auto-generated by tidal derive: Vector Background Domain Wall *)

Print["=== Vector Background Domain Wall ==="];
Print[""];

(* Load xAct packages *)
<< xAct`xTensor`;
<< xAct`xCoba`;

(* Load pipeline modules *)
pipelinePath = "/workspaces/torsion-gertsenshtein/tidal/wolfram";
Get[FileNameJoin[{pipelinePath, "CommonUtilities.wl"}]];
Get[FileNameJoin[{pipelinePath, "EulerLagrange.wl"}]];
Get[FileNameJoin[{pipelinePath, "ComponentDecompose.wl"}]];
Get[FileNameJoin[{pipelinePath, "ExportJSON.wl"}]];

$DefInfoQ = False;

(* Step 1: Define 3D spacetime *)
If[!xTensorQ[vbdM3],
  DefManifold[vbdM3, 3, {a, b, c, d, e, f, g}]
];

If[!MetricQ[vbdEta],
  DefMetric[-1, vbdEta[-a, -b], vbdCD,
    SymbolOfCovD -> {";", "\[Del]"},
    PrintAs -> "\[Eta]"]
];

If[!ChartQ[vbdCart],
  DefChart[vbdCart, vbdM3, {0, 1, 2}, {t[], x[], y[]}]
];

vbdMetricMatrix = DiagonalMatrix[{-1, 1, 1}];
MetricInBasis[vbdEta, -vbdCart, vbdMetricMatrix];

(* Step 2: Define fields *)
If[!xTensorQ[vbdPhi],
  DefTensor[vbdPhi[], vbdM3]
];

If[!xTensorQ[vbdA],
  DefTensor[vbdA[-a], vbdM3]
];

(* Define constant symbols *)
If[!ConstantSymbolQ[mPhi2], DefConstantSymbol[mPhi2]];
If[!ConstantSymbolQ[mA2], DefConstantSymbol[mA2]];
If[!ConstantSymbolQ[gBV], DefConstantSymbol[gBV]];
If[!ConstantSymbolQ[B0], DefConstantSymbol[B0]];
If[!ConstantSymbolQ[W], DefConstantSymbol[W]];
If[!ConstantSymbolQ[R], DefConstantSymbol[R]];

(* Background fields — non-dynamical (not varied in Euler-Lagrange) *)
If[!xTensorQ[vbdB],
  DefTensor[vbdB[-a], vbdM3]
];

ComponentValue[vbdB[{0, -vbdCart}], 0];
ComponentValue[vbdB[{1, -vbdCart}], 0];
ComponentValue[vbdB[{2, -vbdCart}], B0 * Tanh[x[] / W] * Exp[-(y[]^2) / (2 * R^2)]];


(* Step 3: Lagrangian *)
vbdLagrangian = (
  (-1/2 vbdCD[-a][vbdPhi[]] vbdEta[a,b] vbdCD[-b][vbdPhi[]] - mPhi2/2 * vbdPhi[]^2 - 1/2 vbdCD[-a][vbdA[-b]] vbdEta[a,c] vbdEta[b,d] vbdCD[-c][vbdA[-d]] + 1/2 vbdCD[-a][vbdA[-b]] vbdEta[a,c] vbdEta[b,d] vbdCD[-d][vbdA[-c]] - mA2/2 vbdA[-a] vbdEta[a,b] vbdA[-b] + gBV * vbdB[-a] vbdEta[a,b] vbdA[-b] * vbdPhi[])
);

Print["Lagrangian: ", vbdLagrangian];

(* Step 4: Euler-Lagrange equations *)
eomPhi = VarD[vbdPhi[], vbdCD][vbdLagrangian];
eomPhi = ToCanonical[eomPhi];
eomPhi = ContractMetric[eomPhi, vbdEta];
Print["EOM phi: ", eomPhi];

eomA = VarD[vbdA[-a], vbdCD][vbdLagrangian];
eomA = ToCanonical[eomA];
eomA = ContractMetric[eomA, vbdEta];
Print["EOM A: ", eomA];

(* Step 5: Decompose to components *)
compPhi = DecomposeToComponents[eomPhi, vbdPhi[], vbdCart, {vbdA[-a]}, "MetricMatrix" -> vbdMetricMatrix];
Print["phi components: ", Length[compPhi]];
(* Validate background field substitution succeeded *)
ValidateNoUnresolvedBackgrounds[compPhi, {vbdB}];

compA = DecomposeToComponents[eomA, vbdA[-a], vbdCart, {vbdPhi[]}, "MetricMatrix" -> vbdMetricMatrix];
Print["A components: ", Length[compA]];
(* Validate background field substitution succeeded *)
ValidateNoUnresolvedBackgrounds[compA, {vbdB}];

(* Step 6: Build and export JSON *)
fieldEquations = Flatten[{
  Table[{"phi_" <> ToString[compPhi[[k, 1]]], compPhi[[k, 2]]}, {k, Length[compPhi]}],
  Table[{"A_" <> ToString[compA[[k, 1]]], compA[[k, 2]]}, {k, Length[compA]}]
}, 1];

metadata = <|
  "source" -> "xAct",
  "lagrangian_expr" -> "(-1/2 CD[-a][phi[]] eta[a,b] CD[-b][phi[]] - mPhi2/2 * phi[]^2 - 1/2 CD[-a][A[-b]] eta[a,c] eta[b,d] CD[-c][A[-d]] + 1/2 CD[-a][A[-b]] eta[a,c] eta[b,d] CD[-d][A[-c]] - mA2/2 A[-a] eta[a,b] A[-b] + gBV * B[-a] eta[a,b] A[-b] * phi[])",
  "derived_from" -> "Euler-Lagrange",
  "gauge" -> "none",
  "linearized" -> False,
  "dimension" -> 3,
  "signature" -> {-1, 1, 1},
  "coordinates" -> {"t", "x", "y"}
|>;

jsonStructure = BuildMultiFieldJSONStructure[fieldEquations, metadata];

jsonStructure["metadata", "parameters"] = <|"mPhi2" -> 1.0, "mA2" -> 2.0, "gBV" -> 0.5, "B0" -> 1.0, "W" -> 3.0, "R" -> 8.0|>;

outputPath = "/workspaces/torsion-gertsenshtein/examples/data/vector_background.json";
outputDir = DirectoryName[outputPath];
If[outputDir =!= "" && !DirectoryQ[outputDir], CreateDirectory[outputDir]];

Print["JSON Output:"];
Print[ExportString[jsonStructure, "JSON"]];

Export[outputPath, jsonStructure, "JSON"];
Print[""];
Print["Exported to: ", outputPath];

Print["*** Vector Background Domain Wall derivation complete! ***"];
