#!/usr/bin/env wolframscript
(* Auto-generated by tidal derive: Coupled Proca *)

Print["=== Coupled Proca ==="];
Print[""];

(* Load xAct packages *)
<< xAct`xTensor`;
<< xAct`xCoba`;

(* Load pipeline modules *)
pipelinePath = FileNameJoin[{DirectoryName[$InputFileName], "..", "..", "tidal", "wolfram"}];
Get[FileNameJoin[{pipelinePath, "CommonUtilities.wl"}]];
Get[FileNameJoin[{pipelinePath, "EulerLagrange.wl"}]];
Get[FileNameJoin[{pipelinePath, "ComponentDecompose.wl"}]];
Get[FileNameJoin[{pipelinePath, "ExportJSON.wl"}]];

$DefInfoQ = False;

(* Step 1: Define 3D spacetime *)
If[!xTensorQ[cpM3],
  DefManifold[cpM3, 3, {a, b, c, d, e, f, g}]
];

If[!MetricQ[cpEta],
  DefMetric[-1, cpEta[-a, -b], cpCD,
    SymbolOfCovD -> {";", "\[Del]"},
    PrintAs -> "\[Eta]"]
];

If[!ChartQ[cpCart],
  DefChart[cpCart, cpM3, {0, 1, 2}, {t[], x[], y[]}]
];

cpMetricMatrix = DiagonalMatrix[{-1, 1, 1}];
MetricInBasis[cpEta, -cpCart, cpMetricMatrix];

(* Step 2: Define fields *)
If[!xTensorQ[cpA],
  DefTensor[cpA[-a], cpM3]
];

If[!xTensorQ[cpB],
  DefTensor[cpB[-a], cpM3]
];

(* Define constant symbols *)
If[!ConstantSymbolQ[mA2], DefConstantSymbol[mA2]];
If[!ConstantSymbolQ[mB2], DefConstantSymbol[mB2]];
If[!ConstantSymbolQ[gcoup], DefConstantSymbol[gcoup]];

(* Step 3: Lagrangian *)
cpLagrangian = (
  (-1/2 cpCD[-a][cpA[-b]] cpEta[a,c] cpEta[b,d] cpCD[-c][cpA[-d]] + 1/2 cpCD[-a][cpA[-b]] cpEta[a,c] cpEta[b,d] cpCD[-d][cpA[-c]] - mA2/2 cpA[-a] cpEta[a,b] cpA[-b] - 1/2 cpCD[-a][cpB[-b]] cpEta[a,c] cpEta[b,d] cpCD[-c][cpB[-d]] + 1/2 cpCD[-a][cpB[-b]] cpEta[a,c] cpEta[b,d] cpCD[-d][cpB[-c]] - mB2/2 cpB[-a] cpEta[a,b] cpB[-b] + gcoup cpA[-a] cpEta[a,b] cpB[-b])
);

Print["Lagrangian: ", cpLagrangian];

(* Step 4: Euler-Lagrange equations *)
eomA = VarD[cpA[-a], cpCD][cpLagrangian];
eomA = ToCanonical[eomA];
eomA = ContractMetric[eomA, cpEta];
Print["EOM A: ", eomA];

eomB = VarD[cpB[-a], cpCD][cpLagrangian];
eomB = ToCanonical[eomB];
eomB = ContractMetric[eomB, cpEta];
Print["EOM B: ", eomB];

(* Step 5: Decompose to components *)
compA = DecomposeToComponents[eomA, cpA[-a], cpCart, {cpB[-a]}, "MetricMatrix" -> cpMetricMatrix];
Print["A components: ", Length[compA]];

compB = DecomposeToComponents[eomB, cpB[-a], cpCart, {cpA[-a]}, "MetricMatrix" -> cpMetricMatrix];
Print["B components: ", Length[compB]];

(* Step 6: Build and export JSON *)
fieldEquations = Flatten[{
  Table[{"A_" <> ToString[compA[[k, 1]]], compA[[k, 2]]}, {k, Length[compA]}],
  Table[{"B_" <> ToString[compB[[k, 1]]], compB[[k, 2]]}, {k, Length[compB]}]
}, 1];

metadata = <|
  "source" -> "xAct",
  "lagrangian_expr" -> "(-1/2 CD[-a][A[-b]] eta[a,c] eta[b,d] CD[-c][A[-d]] + 1/2 CD[-a][A[-b]] eta[a,c] eta[b,d] CD[-d][A[-c]] - mA2/2 A[-a] eta[a,b] A[-b] - 1/2 CD[-a][B[-b]] eta[a,c] eta[b,d] CD[-c][B[-d]] + 1/2 CD[-a][B[-b]] eta[a,c] eta[b,d] CD[-d][B[-c]] - mB2/2 B[-a] eta[a,b] B[-b] + gcoup A[-a] eta[a,b] B[-b])",
  "derived_from" -> "Euler-Lagrange",
  "gauge" -> "none",
  "linearized" -> False,
  "dimension" -> 3,
  "signature" -> {-1, 1, 1},
  "coordinates" -> {"t", "x", "y"},
  "solve_constraints" -> True,
  "constraint_method" -> "auto",
  "constraint_max_iterations" -> 30,
  "constraint_tolerance" -> 1*^-10,
  "constraint_boundary_conditions" -> <|
    "x" -> <|"type" -> "dirichlet", "value" -> 0.0|>,
    "y" -> <|"type" -> "dirichlet", "value" -> 0.0|>
  |>
|>;

jsonStructure = BuildMultiFieldJSONStructure[fieldEquations, metadata];

jsonStructure["metadata", "parameters"] = <|"mA2" -> 1.0, "mB2" -> 2.0, "gcoup" -> 0.5|>;

outputPath = FileNameJoin[{DirectoryName[$InputFileName], "..", "data", "coupled_proca_3d.json"}];
outputDir = DirectoryName[outputPath];
If[outputDir =!= "" && !DirectoryQ[outputDir], CreateDirectory[outputDir]];

Print["JSON Output:"];
Print[ExportString[jsonStructure, "JSON"]];

Export[outputPath, jsonStructure, "JSON"];
Print[""];
Print["Exported to: ", outputPath];

Print["*** Coupled Proca derivation complete! ***"];

