#!/usr/bin/env wolframscript
(* Auto-generated by tidal derive: Electrostatics *)

Print["=== Electrostatics ==="];
Print[""];

(* Load xAct packages *)
<< xAct`xTensor`;
<< xAct`xCoba`;

(* Load pipeline modules *)
pipelinePath = "/workspaces/torsion-gertsenshtein/tidal/wolfram";
Get[FileNameJoin[{pipelinePath, "CommonUtilities.wl"}]];
Get[FileNameJoin[{pipelinePath, "EulerLagrange.wl"}]];
Get[FileNameJoin[{pipelinePath, "ComponentDecompose.wl"}]];
Get[FileNameJoin[{pipelinePath, "ExportJSON.wl"}]];

$DefInfoQ = False;

(* Step 1: Define 3D spacetime *)
If[!xTensorQ[tidalM3],
  DefManifold[tidalM3, 3, {a, b, c, d, e, f, g}]
];

If[!MetricQ[tidalEta],
  DefMetric[-1, tidalEta[-a, -b], tidalCD,
    SymbolOfCovD -> {";", "\[Del]"},
    PrintAs -> "\[Eta]"]
];

If[!ChartQ[tidalCart],
  DefChart[tidalCart, tidalM3, {0, 1, 2}, {t[], x[], y[]}]
];

tidalMetricMatrix = DiagonalMatrix[{-1, 1, 1}];
MetricInBasis[tidalEta, -tidalCart, tidalMetricMatrix];

(* Step 2: Define fields *)
If[!xTensorQ[tidalPhi],
  DefTensor[tidalPhi[], tidalM3]
];

(* Step 3: Lagrangian *)
tidalLagrangian = (
  -1/2 tidalCD[-a][tidalPhi[]] tidalEta[a, b] tidalCD[-b][tidalPhi[]]
);

Print["Lagrangian: ", tidalLagrangian];

(* Step 4: Euler-Lagrange equations *)
eom = EulerLagrangeEquation[tidalLagrangian, tidalPhi[], tidalCD];
Print["EOM: ", eom];

(* Step 5: Decompose to components *)
componentEqs = DecomposeToComponents[eom, tidalPhi[], tidalCart, {}, "MetricMatrix" -> tidalMetricMatrix];
Print["Components: ", Length[componentEqs]];

fieldEquations = Table[
  {"phi_" <> ToString[componentEqs[[k, 1]]], componentEqs[[k, 2]]},
  {k, Length[componentEqs]}
];

metadata = <|
  "source" -> "xAct",
  "lagrangian_expr" -> "-1/2 CD[-a][phi[]] eta[a, b] CD[-b][phi[]]",
  "derived_from" -> "Euler-Lagrange",
  "gauge" -> "none",
  "linearized" -> False,
  "dimension" -> 3,
  "signature" -> {-1, 1, 1},
  "coordinates" -> {"t", "x", "y"}
|>;

jsonStructure = BuildMultiFieldJSONStructure[fieldEquations, metadata];

outputPath = "/workspaces/torsion-gertsenshtein/examples/data/electrostatics_laplace.json";
outputDir = DirectoryName[outputPath];
If[outputDir =!= "" && !DirectoryQ[outputDir], CreateDirectory[outputDir]];

Print["JSON Output:"];
Print[ExportString[jsonStructure, "JSON"]];

Export[outputPath, jsonStructure, "JSON"];
Print[""];
Print["Exported to: ", outputPath];

Print["*** Electrostatics derivation complete! ***"];
