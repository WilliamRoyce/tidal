#!/usr/bin/env wolframscript
(* Auto-generated by tidal derive: Proca with Lorentzian Background *)

Print["=== Proca with Lorentzian Background ==="];
Print[""];

(* Load xAct packages *)
<< xAct`xTensor`;
<< xAct`xCoba`;

(* Load pipeline modules *)
pipelinePath = "/workspaces/torsion-gertsenshtein/tidal/wolfram";
Get[FileNameJoin[{pipelinePath, "CommonUtilities.wl"}]];
Get[FileNameJoin[{pipelinePath, "EulerLagrange.wl"}]];
Get[FileNameJoin[{pipelinePath, "ComponentDecompose.wl"}]];
Get[FileNameJoin[{pipelinePath, "ExportJSON.wl"}]];

$DefInfoQ = False;

(* Step 1: Define 3D spacetime *)
If[!xTensorQ[pwlM3],
  DefManifold[pwlM3, 3, {a, b, c, d, e, f, g}]
];

If[!MetricQ[pwlEta],
  DefMetric[-1, pwlEta[-a, -b], pwlCD,
    SymbolOfCovD -> {";", "\[Del]"},
    PrintAs -> "\[Eta]"]
];

If[!ChartQ[pwlCart],
  DefChart[pwlCart, pwlM3, {0, 1, 2}, {t[], x[], y[]}]
];

pwlMetricMatrix = DiagonalMatrix[{-1, 1, 1}];
MetricInBasis[pwlEta, -pwlCart, pwlMetricMatrix];

(* Step 2: Define fields *)
If[!xTensorQ[pwlA],
  DefTensor[pwlA[-a], pwlM3]
];

If[!xTensorQ[pwlB],
  DefTensor[pwlB[-a], pwlM3]
];

(* Define constant symbols *)
If[!ConstantSymbolQ[mA2], DefConstantSymbol[mA2]];
If[!ConstantSymbolQ[mB2], DefConstantSymbol[mB2]];
If[!ConstantSymbolQ[gcoup], DefConstantSymbol[gcoup]];
If[!ConstantSymbolQ[g0], DefConstantSymbol[g0]];
If[!ConstantSymbolQ[R], DefConstantSymbol[R]];

(* Background fields — non-dynamical (not varied in Euler-Lagrange) *)
If[!xTensorQ[pwlG],
  DefTensor[pwlG[], pwlM3]
];

ComponentValue[pwlG[], g0 * Power[1 + (x[]^2 + y[]^2) / R^2, -1]];


(* Step 3: Lagrangian *)
pwlLagrangian = (
  (-1/2 pwlCD[-a][pwlA[-b]] pwlEta[a,c] pwlEta[b,d] pwlCD[-c][pwlA[-d]] + 1/2 pwlCD[-a][pwlA[-b]] pwlEta[a,c] pwlEta[b,d] pwlCD[-d][pwlA[-c]] - mA2/2 pwlA[-a] pwlEta[a,b] pwlA[-b] - 1/2 pwlCD[-a][pwlB[-b]] pwlEta[a,c] pwlEta[b,d] pwlCD[-c][pwlB[-d]] + 1/2 pwlCD[-a][pwlB[-b]] pwlEta[a,c] pwlEta[b,d] pwlCD[-d][pwlB[-c]] - mB2/2 pwlB[-a] pwlEta[a,b] pwlB[-b] + pwlG[] * gcoup * pwlA[-a] pwlEta[a,b] pwlB[-b])
);

Print["Lagrangian: ", pwlLagrangian];

(* Step 4: Euler-Lagrange equations *)
eomA = VarD[pwlA[-a], pwlCD][pwlLagrangian];
eomA = ToCanonical[eomA];
eomA = ContractMetric[eomA, pwlEta];
(* Substitute scalar background G -> g0 * Power[1 + (x[]^2 + y[]^2) / R^2, -1] *)
eomA = eomA /. {pwlG[] -> g0 * Power[1 + (x[]^2 + y[]^2) / R^2, -1]};
Print["EOM A: ", eomA];

eomB = VarD[pwlB[-a], pwlCD][pwlLagrangian];
eomB = ToCanonical[eomB];
eomB = ContractMetric[eomB, pwlEta];
(* Substitute scalar background G -> g0 * Power[1 + (x[]^2 + y[]^2) / R^2, -1] *)
eomB = eomB /. {pwlG[] -> g0 * Power[1 + (x[]^2 + y[]^2) / R^2, -1]};
Print["EOM B: ", eomB];

(* Step 5: Decompose to components *)
compA = DecomposeToComponents[eomA, pwlA[-a], pwlCart, {pwlB[-a]}, "MetricMatrix" -> pwlMetricMatrix];
Print["A components: ", Length[compA]];

compB = DecomposeToComponents[eomB, pwlB[-a], pwlCart, {pwlA[-a]}, "MetricMatrix" -> pwlMetricMatrix];
Print["B components: ", Length[compB]];

(* Step 6: Build and export JSON *)
fieldEquations = Flatten[{
  Table[{"A_" <> ToString[compA[[k, 1]]], compA[[k, 2]]}, {k, Length[compA]}],
  Table[{"B_" <> ToString[compB[[k, 1]]], compB[[k, 2]]}, {k, Length[compB]}]
}, 1];

metadata = <|
  "source" -> "xAct",
  "lagrangian_expr" -> "(-1/2 CD[-a][A[-b]] eta[a,c] eta[b,d] CD[-c][A[-d]] + 1/2 CD[-a][A[-b]] eta[a,c] eta[b,d] CD[-d][A[-c]] - mA2/2 A[-a] eta[a,b] A[-b] - 1/2 CD[-a][B[-b]] eta[a,c] eta[b,d] CD[-c][B[-d]] + 1/2 CD[-a][B[-b]] eta[a,c] eta[b,d] CD[-d][B[-c]] - mB2/2 B[-a] eta[a,b] B[-b] + G[] * gcoup * A[-a] eta[a,b] B[-b])",
  "derived_from" -> "Euler-Lagrange",
  "gauge" -> "none",
  "linearized" -> False,
  "dimension" -> 3,
  "signature" -> {-1, 1, 1},
  "coordinates" -> {"t", "x", "y"},
  "solve_constraints" -> True,
  "constraint_method" -> "auto",
  "constraint_max_iterations" -> 30,
  "constraint_tolerance" -> 1*^-10,
  "constraint_boundary_conditions" -> <|
    "x" -> <|"type" -> "periodic"|>,
    "y" -> <|"type" -> "periodic"|>
  |>
|>;

jsonStructure = BuildMultiFieldJSONStructure[fieldEquations, metadata];

jsonStructure["metadata", "parameters"] = <|"mA2" -> 1.0, "mB2" -> 2.0, "gcoup" -> 0.5, "g0" -> 1.0, "R" -> 8.0|>;

outputPath = "/workspaces/torsion-gertsenshtein/examples/data/proca_background.json";
outputDir = DirectoryName[outputPath];
If[outputDir =!= "" && !DirectoryQ[outputDir], CreateDirectory[outputDir]];

Print["JSON Output:"];
Print[ExportString[jsonStructure, "JSON"]];

Export[outputPath, jsonStructure, "JSON"];
Print[""];
Print["Exported to: ", outputPath];

Print["*** Proca with Lorentzian Background derivation complete! ***"];
