#!/usr/bin/env wolframscript
(* Auto-generated by tidal derive: Linearized Gravity *)

Print["=== Linearized Gravity ==="];
Print[""];

(* Load xAct packages *)
<< xAct`xTensor`;
<< xAct`xCoba`;
<< xAct`xPert`;

(* Load pipeline modules *)
pipelinePath = "/workspaces/torsion-gertsenshtein/tidal/wolfram";
Get[FileNameJoin[{pipelinePath, "CommonUtilities.wl"}]];
Get[FileNameJoin[{pipelinePath, "EulerLagrange.wl"}]];
Get[FileNameJoin[{pipelinePath, "ComponentDecompose.wl"}]];
Get[FileNameJoin[{pipelinePath, "ExportJSON.wl"}]];
Get[FileNameJoin[{pipelinePath, "Linearize.wl"}]];

$DefInfoQ = False;

(* Step 1: Define 4D spacetime *)
If[!xTensorQ[lgM4],
  DefManifold[lgM4, 4, {a, b, c, d, e, f, g, h}]
];

If[!MetricQ[lgEta],
  DefMetric[-1, lgEta[-a, -b], lgCD,
    SymbolOfCovD -> {";", "\[Del]"},
    PrintAs -> "\[Eta]"]
];

If[!ChartQ[lgCart],
  DefChart[lgCart, lgM4, {0, 1, 2, 3}, {t[], x[], y[], z[]}]
];

lgMetricMatrix = DiagonalMatrix[{-1, 1, 1, 1}];
MetricInBasis[lgEta, -lgCart, lgMetricMatrix];

(* Step 2: Define fields *)
If[!xTensorQ[lgH],
  DefTensor[lgH[-a, -b], lgM4, Symmetric[{-a, -b}],
    PrintAs -> "h"]
];

(* Step 3: xPert metric perturbation setup *)
lghpertTensor = SetupMetricPerturbation[lgEta, lghpert, lgEpsilon];
Print["Perturbation: metric = background + lgEpsilon * h"];

(* Step 4: Linearize tensor expression *)
linExpr = LinearizeTensorExpression[Einstein[lgCD][-a, -b]];
Print["Linearized expression: ", Short[linExpr, 3]];

(* Convert xPert notation to plain tensor for pipeline *)
linExprPlain = linExpr /. lghpert[LI[1], idx__] :> lgH[idx];
linExprPlain = Simplify[linExprPlain];
Print["Converted to plain tensor: ", Short[linExprPlain, 3]];

(* Step 5: Decompose to components *)
componentEqs = DecomposeToComponents[linExprPlain, lgH[-a, -b], lgCart, {}, "MetricMatrix" -> lgMetricMatrix];
Print["Components: ", Length[componentEqs]];

fieldEquations = Table[
  {"h_" <> ToString[componentEqs[[k, 1]]], componentEqs[[k, 2]]},
  {k, Length[componentEqs]}
];

metadata = <|
  "source" -> "xAct",
  "lagrangian_expr" -> "Einstein[CD][-a, -b]",
  "derived_from" -> "Euler-Lagrange",
  "gauge" -> "none",
  "linearized" -> True,
  "dimension" -> 4,
  "signature" -> {-1, 1, 1, 1},
  "coordinates" -> {"t", "x", "y", "z"}
|>;

jsonStructure = BuildMultiFieldJSONStructure[fieldEquations, metadata];

outputPath = "/workspaces/torsion-gertsenshtein/examples/data/linearized_gravity.json";
outputDir = DirectoryName[outputPath];
If[outputDir =!= "" && !DirectoryQ[outputDir], CreateDirectory[outputDir]];

Print["JSON Output:"];
Print[ExportString[jsonStructure, "JSON"]];

Export[outputPath, jsonStructure, "JSON"];
Print[""];
Print["Exported to: ", outputPath];

Print["*** Linearized Gravity derivation complete! ***"];
