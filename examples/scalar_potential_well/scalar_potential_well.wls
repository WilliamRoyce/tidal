#!/usr/bin/env wolframscript
(* Auto-generated by tidal derive: Scalar Potential Well *)

Print["=== Scalar Potential Well ==="];
Print[""];

(* Load xAct packages *)
<< xAct`xTensor`;
<< xAct`xCoba`;

(* Load pipeline modules *)
pipelinePath = "/workspaces/torsion-gertsenshtein/tidal/wolfram";
Get[FileNameJoin[{pipelinePath, "CommonUtilities.wl"}]];
Get[FileNameJoin[{pipelinePath, "EulerLagrange.wl"}]];
Get[FileNameJoin[{pipelinePath, "ComponentDecompose.wl"}]];
Get[FileNameJoin[{pipelinePath, "ExportJSON.wl"}]];

$DefInfoQ = False;

(* Step 1: Define 2D spacetime *)
If[!xTensorQ[spwM2],
  DefManifold[spwM2, 2, {a, b, c, d, e, f}]
];

If[!MetricQ[spwEta],
  DefMetric[-1, spwEta[-a, -b], spwCD,
    SymbolOfCovD -> {";", "\[Del]"},
    PrintAs -> "\[Eta]"]
];

If[!ChartQ[spwCart],
  DefChart[spwCart, spwM2, {0, 1}, {t[], x[]}]
];

spwMetricMatrix = DiagonalMatrix[{-1, 1}];
MetricInBasis[spwEta, -spwCart, spwMetricMatrix];

(* Step 2: Define fields *)
If[!xTensorQ[spwPhi],
  DefTensor[spwPhi[], spwM2]
];

(* Define constant symbols *)
If[!ConstantSymbolQ[V0], DefConstantSymbol[V0]];

(* Background fields — non-dynamical (not varied in Euler-Lagrange) *)
If[!xTensorQ[spwV],
  DefTensor[spwV[], spwM2]
];

ComponentValue[spwV[], V0 * UnitStep[x[] - 30] * UnitStep[60 - x[]]];


(* Step 3: Lagrangian *)
spwLagrangian = (
  -1/2 spwCD[-a][spwPhi[]] spwEta[a, b] spwCD[-b][spwPhi[]] - spwV[]/2 * spwPhi[]^2
);

Print["Lagrangian: ", spwLagrangian];

(* Step 4: Euler-Lagrange equations *)
eom = EulerLagrangeEquation[spwLagrangian, spwPhi[], spwCD];
Print["EOM: ", eom];

(* Substitute scalar background V -> V0 * UnitStep[x[] - 30] * UnitStep[60 - x[]] *)
eom = eom /. {spwV[] -> V0 * UnitStep[x[] - 30] * UnitStep[60 - x[]]};
(* Step 5: Decompose to components *)
componentEqs = DecomposeToComponents[eom, spwPhi[], spwCart, {}, "MetricMatrix" -> spwMetricMatrix];
Print["Components: ", Length[componentEqs]];

fieldEquations = Table[
  {"phi_" <> ToString[componentEqs[[k, 1]]], componentEqs[[k, 2]]},
  {k, Length[componentEqs]}
];

metadata = <|
  "source" -> "xAct",
  "lagrangian_expr" -> "-1/2 CD[-a][phi[]] eta[a, b] CD[-b][phi[]] - V[]/2 * phi[]^2",
  "derived_from" -> "Euler-Lagrange",
  "gauge" -> "none",
  "linearized" -> False,
  "dimension" -> 2,
  "signature" -> {-1, 1},
  "coordinates" -> {"t", "x"}
|>;

jsonStructure = BuildMultiFieldJSONStructure[fieldEquations, metadata];

jsonStructure["metadata", "parameters"] = <|"V0" -> 4.0|>;

outputPath = "/workspaces/torsion-gertsenshtein/examples/data/scalar_potential_well.json";
outputDir = DirectoryName[outputPath];
If[outputDir =!= "" && !DirectoryQ[outputDir], CreateDirectory[outputDir]];

Print["JSON Output:"];
Print[ExportString[jsonStructure, "JSON"]];

Export[outputPath, jsonStructure, "JSON"];
Print[""];
Print["Exported to: ", outputPath];

Print["*** Scalar Potential Well derivation complete! ***"];
