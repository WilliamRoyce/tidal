#!/usr/bin/env wolframscript
(* Auto-generated by tidal derive: Coupled Scalar Scattering *)

Print["=== Coupled Scalar Scattering ==="];
Print[""];

(* Load xAct packages *)
<< xAct`xTensor`;
<< xAct`xCoba`;

(* Load pipeline modules *)
pipelinePath = "/workspaces/torsion-gertsenshtein/tidal/wolfram";
Get[FileNameJoin[{pipelinePath, "CommonUtilities.wl"}]];
Get[FileNameJoin[{pipelinePath, "EulerLagrange.wl"}]];
Get[FileNameJoin[{pipelinePath, "ComponentDecompose.wl"}]];
Get[FileNameJoin[{pipelinePath, "ExportJSON.wl"}]];

$DefInfoQ = False;

(* Step 1: Define 3D spacetime *)
If[!xTensorQ[cssM3],
  DefManifold[cssM3, 3, {a, b, c, d, e, f, g}]
];

If[!MetricQ[cssEta],
  DefMetric[-1, cssEta[-a, -b], cssCD,
    SymbolOfCovD -> {";", "\[Del]"},
    PrintAs -> "\[Eta]"]
];

If[!ChartQ[cssCart],
  DefChart[cssCart, cssM3, {0, 1, 2}, {t[], x[], y[]}]
];

cssMetricMatrix = DiagonalMatrix[{-1, 1, 1}];
MetricInBasis[cssEta, -cssCart, cssMetricMatrix];

(* Step 2: Define fields *)
If[!xTensorQ[cssPhi],
  DefTensor[cssPhi[], cssM3]
];

If[!xTensorQ[cssChi],
  DefTensor[cssChi[], cssM3]
];

(* Define constant symbols *)
If[!ConstantSymbolQ[mPhi2], DefConstantSymbol[mPhi2]];
If[!ConstantSymbolQ[mChi2], DefConstantSymbol[mChi2]];
If[!ConstantSymbolQ[g0], DefConstantSymbol[g0]];
If[!ConstantSymbolQ[R], DefConstantSymbol[R]];

(* Background fields — non-dynamical (not varied in Euler-Lagrange) *)
If[!xTensorQ[cssG],
  DefTensor[cssG[], cssM3]
];

ComponentValue[cssG[], g0 * Exp[-(x[]^2 + y[]^2) / (2 * R^2)]];


(* Step 3: Lagrangian *)
cssLagrangian = (
  -1/2 cssCD[-a][cssPhi[]] cssEta[a, b] cssCD[-b][cssPhi[]] - 1/2 cssCD[-a][cssChi[]] cssEta[a, b] cssCD[-b][cssChi[]] - mPhi2/2 * cssPhi[]^2 - mChi2/2 * cssChi[]^2 - cssG[] * cssPhi[] * cssChi[]
);

Print["Lagrangian: ", cssLagrangian];

(* Step 4: Euler-Lagrange equations *)
eomPhi = VarD[cssPhi[], cssCD][cssLagrangian];
eomPhi = ToCanonical[eomPhi];
eomPhi = ContractMetric[eomPhi, cssEta];
(* Substitute scalar background G -> g0 * Exp[-(x[]^2 + y[]^2) / (2 * R^2)] *)
eomPhi = eomPhi /. {cssG[] -> g0 * Exp[-(x[]^2 + y[]^2) / (2 * R^2)]};
Print["EOM phi: ", eomPhi];

eomChi = VarD[cssChi[], cssCD][cssLagrangian];
eomChi = ToCanonical[eomChi];
eomChi = ContractMetric[eomChi, cssEta];
(* Substitute scalar background G -> g0 * Exp[-(x[]^2 + y[]^2) / (2 * R^2)] *)
eomChi = eomChi /. {cssG[] -> g0 * Exp[-(x[]^2 + y[]^2) / (2 * R^2)]};
Print["EOM chi: ", eomChi];

(* Step 5: Decompose to components *)
compPhi = DecomposeToComponents[eomPhi, cssPhi[], cssCart, {cssChi[]}, "MetricMatrix" -> cssMetricMatrix];
Print["phi components: ", Length[compPhi]];

compChi = DecomposeToComponents[eomChi, cssChi[], cssCart, {cssPhi[]}, "MetricMatrix" -> cssMetricMatrix];
Print["chi components: ", Length[compChi]];

(* Step 6: Build and export JSON *)
fieldEquations = Flatten[{
  Table[{"phi_" <> ToString[compPhi[[k, 1]]], compPhi[[k, 2]]}, {k, Length[compPhi]}],
  Table[{"chi_" <> ToString[compChi[[k, 1]]], compChi[[k, 2]]}, {k, Length[compChi]}]
}, 1];

metadata = <|
  "source" -> "xAct",
  "lagrangian_expr" -> "-1/2 CD[-a][phi[]] eta[a, b] CD[-b][phi[]] - 1/2 CD[-a][chi[]] eta[a, b] CD[-b][chi[]] - mPhi2/2 * phi[]^2 - mChi2/2 * chi[]^2 - G[] * phi[] * chi[]",
  "derived_from" -> "Euler-Lagrange",
  "gauge" -> "none",
  "linearized" -> False,
  "dimension" -> 3,
  "signature" -> {-1, 1, 1},
  "coordinates" -> {"t", "x", "y"}
|>;

jsonStructure = BuildMultiFieldJSONStructure[fieldEquations, metadata];

jsonStructure["metadata", "parameters"] = <|"mPhi2" -> 1.0, "mChi2" -> 4.0, "g0" -> 1.0, "R" -> 8.0|>;

outputPath = "/workspaces/torsion-gertsenshtein/examples/data/coupled_scattering.json";
outputDir = DirectoryName[outputPath];
If[outputDir =!= "" && !DirectoryQ[outputDir], CreateDirectory[outputDir]];

Print["JSON Output:"];
Print[ExportString[jsonStructure, "JSON"]];

Export[outputPath, jsonStructure, "JSON"];
Print[""];
Print["Exported to: ", outputPath];

Print["*** Coupled Scalar Scattering derivation complete! ***"];
