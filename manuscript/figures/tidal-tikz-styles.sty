\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tidal-tikz-styles}[2026/03/17 TIDAL TikZ shared styles]

% ---------------------------------------------------------------
% Required packages
% ---------------------------------------------------------------
\RequirePackage[T1]{fontenc}
% PassOptionsToPackage must precede any load of tikz/pgf, which
% internally calls \RequirePackage{xcolor} without options.  By
% declaring svgnames here first, pgf picks up the option and the
% subsequent explicit load below is then a no-op rather than a clash.
\PassOptionsToPackage{svgnames}{xcolor}
\RequirePackage{tikz}
\RequirePackage[svgnames]{xcolor}
\RequirePackage{amsmath}

\usetikzlibrary{
    shapes.geometric,
    arrows.meta,
    positioning,
    calc,
    fit,
    backgrounds,
    matrix,
    decorations.pathreplacing,
    decorations.pathmorphing,
    decorations.markings,
}

% ---------------------------------------------------------------
% Colour palette (https://www.color-hex.com/color-palette/1044488
%
% Convention: XxxLine = border (darker), XxxFill = fill (lighter).
% Parametric styles take the *base name* (e.g. Purple) and append
% Line / Fill automatically: stage=Purple → draw=PurpleLine,
% fill=PurpleFill!40,.
% ---------------------------------------------------------------

\definecolor{IBMyellow}{RGB}{255, 176, 0}
\definecolor{IBMorange}{RGB}{254, 97, 0}
\definecolor{IBMmagenta}{RGB}{220, 38, 127}
\definecolor{IBMindigo}{RGB}{120, 94, 240}
\definecolor{IBMblue}{RGB}{100, 143, 255}

\colorlet{OrangeFill}{LightSalmon}
\colorlet{OrangeLine}{DarkSalmon!30!Chocolate}
\colorlet{GreenFill}{MediumAquamarine}
\colorlet{GreenLine}{MediumAquamarine!30!Teal}
\colorlet{PurpleFill}{MediumPurple}
\colorlet{PurpleLine}{MediumPurple!30!SlateBlue}
\colorlet{PinkFill}{Thistle!50!Plum}
\colorlet{PinkLine}{Thistle!30!Orchid}
\colorlet{BlueFill}{LightSkyBlue}
\colorlet{BlueLine}{SteelBlue}
\colorlet{LimeFill}{YellowGreen}
\colorlet{LimeLine}{YellowGreen!30!Olive}
\colorlet{GrayFill}{LightGray!60!OldLace}
\colorlet{GrayLine}{RosyBrown!50!Silver}

% ---------------------------------------------------------------
% Shared TikZ styles — single source of truth for all figures.
%
% Parametric colour styles take a base name: stage=Purple expands
% to draw=PurpleLine, fill=PurpleFill!40,.
% Individual figures may add file-specific styles but should NOT
% redefine these.  Per-node size overrides are fine.
% ---------------------------------------------------------------
\tikzset{
    % --- Generic pipeline / flowchart stage ---
    % Usage: stage=Purple, stage=Blue, stage=Gray, etc.
    stage/.style={
        rectangle, rounded corners=2pt, minimum width=3.0cm,
        minimum height=0.8cm, draw=#1Line, line width=0.7pt,
        fill=#1Fill!40, font=\footnotesize,
        align=center, text=black
    },
    stage/.default={Gray},
    % --- Solver outcome box (bold label) ---
    % Usage: solver=Purple, solver=Orange, etc.
    solver/.style={
        rectangle, rounded corners=2pt, minimum width=2.2cm,
        minimum height=0.6cm, draw=#1Line,
        fill=#1Fill!40,
        font=\footnotesize\bfseries, align=center,
        text opacity=1, text=black
    },
    solver/.default={Gray},
    % --- Decision diamonds ---
    decision/.style={
        diamond, aspect=1.8, minimum width=1.2cm,
        draw=black!70, fill=white, font=\footnotesize,
        align=center, inner sep=0.5pt, text width=1.6cm
    },
    % --- Dashed check / condition box ---
    check/.style={
        rectangle, rounded corners=1pt, draw=OrangeLine, dashed,
        fill=OrangeFill!25, font=\scriptsize,
        align=center, inner sep=3pt
    },
    % --- Sub-check panel (multi-condition, left-aligned) ---
    subcheck/.style={
        rectangle, rounded corners=2pt, draw=PinkLine, dashed,
        fill=PinkFill!40, font=\scriptsize, align=left,
        text opacity=1, inner sep=6pt, text width=5.2cm
    },
    % --- Detail / explanation box (parametric colour) ---
    % Blue analog of 'schur' — used for Path B annotations etc.
    detail/.style={
        rectangle, rounded corners=2pt, draw=#1Line, dashed,
        fill=#1Fill!30, font=\scriptsize,
        align=center, inner sep=5pt, text width=3.6cm
    },
    detail/.default={Blue},
    % --- Preset / tag box ---
    preset/.style={
        rectangle, rounded corners=1pt, draw=GrayLine,
        fill=GrayFill!40, font=\scriptsize\ttfamily,
        align=center, inner sep=3pt
    },
    % --- Optimisation cascade phase ---
    % Usage: phase=Pink, phase=Blue, etc.
    phase/.style={
        rectangle, rounded corners=2pt, minimum width=7.0cm,
        minimum height=0.65cm, draw=#1Line, line width=0.7pt,
        fill=#1Fill!40, font=\footnotesize, align=left,
        text opacity=1, text=black, inner sep=5pt
    },
    phase/.default={Gray},
    % --- Speedup annotation ---
    speedup/.style={
        font=\scriptsize\bfseries, text=#1Line, align=right
    },
    speedup/.default={Green},
    % --- Cost annotation ---
    cost/.style={
        font=\scriptsize\bfseries, text=#1Line, align=center
    },
    cost/.default={Gray},
    % --- Italic annotation (set text width per-node as needed) ---
    annot/.style={
        font=\scriptsize\itshape, text=GrayLine, align=center
    },
    % --- Data / intermediate artefact box ---
    data/.style={
        rectangle, minimum width=1.6cm, minimum height=0.7cm,
        draw=GrayLine, fill=GrayFill, fill opacity=0.5,
        font=\footnotesize, align=center,
        rounded corners=1pt
    },
    % --- Library / external tool label ---
    lib/.style={
        font=\scriptsize\itshape, text=GrayLine, align=center
    },
    % --- Wolfram module label ---
    wlmod/.style={
        font=\scriptsize\ttfamily, text=PinkLine, anchor=west
    },
    % --- Standard arrows ---
    arr/.style={
        -{Stealth[length=5pt, width=4pt]}, thick, black!70
    },
    dataarr/.style={
        -{Stealth[length=4pt, width=3pt]}, thick, GrayLine
    },
    dotarr/.style={
        -{Stealth[length=4pt, width=3pt]}, densely dotted, GrayLine
    },
    cachearr/.style={
        -{Stealth[length=4pt, width=3pt]}, semithick, BlueLine,
        densely dashed
    },
    % --- Edge labels ---
    yeslbl/.style={font=\scriptsize\bfseries, text=black!70},
    nolbl/.style={font=\scriptsize\bfseries, text=black!70},
    % --- Algorithm-level styles (for detailed code flowcharts) ---
    % Function call box: monospaced name, compact, with optional line ref.
    % Usage: funcbox=Purple, funcbox=Pink, etc.
    funcbox/.style={
        rectangle, rounded corners=1.5pt, minimum width=2.4cm,
        minimum height=0.6cm, draw=#1Line, line width=0.5pt,
        fill=#1Fill!25, font=\scriptsize\ttfamily,
        align=center, text=black
    },
    funcbox/.default={Purple},
    % Line-number reference annotation (right-margin code pointers).
    lineref/.style={
        font=\sffamily\tiny, text=GrayLine, anchor=west, align=left
    },
    % Iteration / fixed-point loop background region (applied via fit).
    % Usage: \node[loopregion, fit=(a)(b)(c)] {};
    loopregion/.style={
        rectangle, rounded corners=4pt, draw=BlueLine, densely dashed,
        fill=BlueFill, fill opacity=0.08, inner sep=8pt,
        line width=0.6pt
    },
    % Fixed-point convergence check (smaller diamond than decision).
    fpcheck/.style={
        diamond, aspect=2.0, minimum width=1.2cm,
        draw=OrangeLine, fill=OrangeFill!20, font=\tiny,
        align=center, inner sep=1pt, text width=1.6cm
    },
    % Code-reference annotation arrow (thin, gray, dashed).
    codearr/.style={
        -{Stealth[length=3pt, width=2pt]}, thin, GrayLine,
        densely dashed
    },
}
